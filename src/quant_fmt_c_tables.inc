// ============================================================================
//  quant_fmt_c_tables.inc — codebooks for IQ3_S, IQ1_S and IQ1_M.
//
//  Transcribed from ggml's ggml-common.h (GGML_TABLE_BEGIN(uint32_t,
//  iq3s_grid, 512) and GGML_TABLE_BEGIN(uint64_t, iq1s_grid, NGRID_IQ1S) with
//  NGRID_IQ1S = 2048). Entry values are byte-for-byte the reference's; the
//  counts (512 and 2048) are the reference's declared sizes, and a truncated
//  table would decode into whatever follows it rather than failing.
//
//  WHY THIS FILE IS SHARED rather than duplicated per side
//  ------------------------------------------------------
//  The reference itself generates one table per build flavour from one source
//  (its GGML_TABLE_BEGIN macro resolves to `static const` for the host and
//  `static const __device__` for HIP). These two tables are ~19 KiB of
//  codebook, and the failure this file is designed to make impossible is the
//  host and device copies disagreeing: a hand-transcribed second copy of a
//  2048-entry table has 2048 independent chances to be wrong, and a divergence
//  would show up as "the GPU and the CPU reference disagree" with no hint that
//  the tables were the reason. So it is included by BOTH
//  `src/quant_fmt_c.inc` (the host dequantizers, inside the anonymous
//  namespace of src/quant.cpp) and
//  `src/hip/kernels/dequant_fmt_c.inc` (inside namespace krk), and the device
//  side asks for the device flavour by defining KRK_FMT_TABLE_DEVICE first.
//  The switch is an explicit macro rather than a compiler macro
//  (__HIP_DEVICE_COMPILE__): the host pass of a HIP translation unit parses
//  this file too, and an explicit define cannot be accidentally right in one
//  compiler and wrong in another.
//
//  The sign mask table (ggml kmask_iq2xs) is NOT here -- it is already
//  present on both sides as kMaskIq2xs / kDevMaskIq2xs, and IQ3_S reuses it.
// ============================================================================
#ifndef KRK_QUANT_FMT_C_TABLES_INC
#define KRK_QUANT_FMT_C_TABLES_INC

#if defined(KRK_FMT_TABLE_DEVICE)
#define KRK_FMT_TBL(type, name) __device__ static const type name
#else
#define KRK_FMT_TBL(type, name) static const type name
#endif

