// IQ2_XS (2.3125 bpw), 74-byte blocks of 256 values. Chunk c is one of the 8
// 32-value groups; within it the four sub-groups of 8 each take a 16-bit word:
// bits 0..8 index the codebook, bits 9..15 index the sign table, and sub-groups
// 0/1 use the low scale nibble and 2/3 the high one. Mirrors
// `dequantize_row_iq2_xs`, and is the device twin of deq_iq2_xs in src/quant.cpp.
__device__ __forceinline__ void dequant_chunk_iq2_xs(const u8 *b, int chunk,
                                                    _Float16 *y) {
    const f32 d = d_h2f(static_cast<u16>(b[0] | (b[1] << 8)));
    const u8 scale = b[66 + chunk];
    const f32 db0 = d * (0.5f + static_cast<f32>(scale & 0x0F)) * 0.25f;
    const f32 db1 = d * (0.5f + static_cast<f32>(scale >> 4)) * 0.25f;
#pragma unroll
    for (int l = 0; l < 4; l++) {
        const int idx = 4 * chunk + l;
        const u16 q = static_cast<u16>(b[2 + 2 * idx] | (b[3 + 2 * idx] << 8));
        const u64 grid = kDevIq2xsGrid[q & 511u];
        const u8 signs = kDevSignsIq2xs[(q >> 9) & 127u];
        const f32 db = (l >> 1) ? db1 : db0;
#pragma unroll
        for (int j = 0; j < 8; j++) {
            const f32 g = static_cast<f32>(
                static_cast<int>((grid >> (8 * j)) & 0xFFu));
            y[8 * l + j] = static_cast<_Float16>(
                db * g * ((signs & kDevMaskIq2xs[j]) ? -1.f : 1.f));
        }
    }
}

// IQ2_S (2.5625 bpw), 82-byte blocks of 256 values. Chunk c is one 32-value
// group. The grid index is 10 bits: the low 8 from the group's four qs bytes
// and two more from a bit pair of qh[c], selected per sub-group l as
// `(qh[c] << (8 - 2*l)) & 0x300`. The signs are NOT looked up in a table -- the
// reference uses the sign byte directly (one bit per value). Mirrors
// `dequantize_row_iq2_s` and the host deq_iq2_s in src/quant_fmt_b.inc.
__device__ __forceinline__ void dequant_chunk_iq2_s(const u8 *b, int chunk,
                                                    _Float16 *y) {
    const f32 d = d_h2f(static_cast<u16>(b[0] | (b[1] << 8)));
    const u8 qh = b[66 + chunk];
    const u8 scale = b[74 + chunk];
    const f32 db0 = d * (0.5f + static_cast<f32>(scale & 0x0F)) * 0.25f;
    const f32 db1 = d * (0.5f + static_cast<f32>(scale >> 4)) * 0.25f;
#pragma unroll
    for (int l = 0; l < 4; l++) {
        const int idx = static_cast<int>(b[2 + 4 * chunk + l]) |
                        ((qh << (8 - 2 * l)) & 0x300);
        const u64 grid = kDevIq2sGrid[idx];
        // qs is 64 bytes and the reference's `signs` points at qs + QK_K/8, so
        // group c's four sign bytes are b[34 + 4c .. 34 + 4c + 3].
        const u8 sign = b[34 + 4 * chunk + l];
        const f32 db = (l >> 1) ? db1 : db0;
#pragma unroll
        for (int j = 0; j < 8; j++) {
            const f32 g = static_cast<f32>(
                static_cast<int>((grid >> (8 * j)) & 0xFFu));
            y[8 * l + j] = static_cast<_Float16>(
                db * g * ((sign & kDevMaskIq2xs[j]) ? -1.f : 1.f));
        }
    }
}
