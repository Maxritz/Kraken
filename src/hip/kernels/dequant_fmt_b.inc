// ============================================================================
//  dequant_fmt_b.inc — device decoders for IQ2_XS (ggml id 17) and IQ2_S (22).
//
//  Included by src/hip/kernels/dequant.hpp, inside `namespace krk`, immediately
//  BEFORE `dequant_chunk` is defined, because `dequant_chunk`'s dtype ladder and
//  `dequant_chunk_dev`'s switch both forward into the helpers below.
//
//  COORDINATOR NOTE, because this file does one unusual thing: the IQ2_S
//  codebook (1024 entries, 8 KiB) is NOT duplicated here. It is pulled in from
//  src/quant_fmt_b.inc -- the host decoder file -- with KRK_IQ2_FMT_B_DEVICE
//  defined, which makes that file emit the identical table under a __device__
//  qualifier and skip its host decoder. One copy of the constants, two
//  consumers. 8 KiB of hex is the part of this slice a transcription slip would
//  corrupt silently, so it is worth having only one copy to check.
//  Delete either #define and the table stops being emitted on this side.
//
//  Both formats are the "grid + signs" family: every 8 values come from one
//  64-bit codebook entry whose 8 bytes are the magnitudes, and one bit of a sign
//  byte negates each. 8 chunks of 32 values per block for both.
// ============================================================================

#define KRK_IQ2_FMT_B_DEVICE 1
#include "../../quant_fmt_b.inc"
#undef KRK_IQ2_FMT_B_DEVICE

