+// 32-weight blocks, and every lane pointer has to be live for the duration of
+// the tile loop, which the caller guarantees by keeping the queue drained
+// around a weight whose storage it is about to move.
+static void execute_matmul_q8_0(ExecCtx &ctx)
+{
+    const auto &in = ctx.cmd->args.matmul_q8_0;
+    if (!in.A || !in.B || !in.C || !in.M || !in.N || !in.K)
+        throw std::runtime_error("matmul_q8_0: null operand or empty shape");
+    if (in.K % 32u)
+        throw std::runtime_error("matmul_q8_0: K must be a multiple of 32");
+    GemmQ80Params p{};
+    p.A = in.A;
+    p.B = static_cast<const uint8_t *>(in.B);
+    p.C = in.C;
+    p.M = in.M;
+    p.K = in.K;
+    p.N = in.N;
+    p.lda = in.lda ? in.lda : in.K;
+    p.ldc = in.ldc ? in.ldc : in.N;
+    p.epilogue = in.epilogue;
+    p.unit = in.unit;
+    p.isa = ctx.device->cpu.isa;
+    p.tile_m = ctx.device->tile_m.load();
+    p.tile_k = ctx.device->tile_k.load();
+    p.tile_n = ctx.device->tile_n.load();
+
+    uint32_t unit = in.unit ? in.unit : VNPU_UNIT_VOODOO;
+    std::vector<TileJob> tiles;
+    vnpu_status_t rc = build_tiles_generic(ctx.device, in.M, in.N, unit,
+                                           nullptr, 0, 0, tiles);
+    if (rc != VNPU_OK) throw std::runtime_error(vnpu_status_string(rc));
+    p.tiles = &tiles;
+    uint64_t active = 0;
+    for (const auto &t : tiles)
+        if (!t.cull) active++;
+    ctx.tiles_dispatched += active;
+    ctx.tiles_culled += tiles.size() - active;
+    uint64_t grain = std::max<uint64_t>(1,
+        ceil_div_u32(static_cast<uint32_t>(tiles.size()),
+                     static_cast<uint32_t>(ctx.device->info.num_threads * 4)));
