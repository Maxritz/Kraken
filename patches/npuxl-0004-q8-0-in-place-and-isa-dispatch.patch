+        const float *arow = p.A + static_cast<size_t>(m) * p.lda;
+        for (uint32_t n = tile.n0; n < tile.n0 + tile.tn; ++n) {
+            const uint8_t *brow = p.B + static_cast<size_t>(n) * (p.K / 32u) * 34u;
+            float total = 0.0f;
+            for (uint32_t b = 0; b < p.K / 32u; ++b) {
+                const uint8_t *blk = brow + static_cast<size_t>(b) * 34u;
+                const float d = q8_0_block_scale(blk);
+                const int8_t *q = reinterpret_cast<const int8_t *>(blk + 2);
+                float acc = 0.0f;
