+        const float *a0 = p.A + static_cast<size_t>(m + 0) * p.lda;
+        const float *a1 = p.A + static_cast<size_t>(m + 1) * p.lda;
+        const float *a2 = p.A + static_cast<size_t>(m + 2) * p.lda;
+        const float *a3 = p.A + static_cast<size_t>(m + 3) * p.lda;
