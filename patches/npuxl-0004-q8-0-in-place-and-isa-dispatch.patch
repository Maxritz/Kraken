+    uint64_t b_bytes = static_cast<uint64_t>(in.N) * (in.K / 32u) * 34u;
+    uint64_t c_bytes = static_cast<uint64_t>(in.M) * in.N * sizeof(float);
+    ctx.add_bytes(a_bytes + b_bytes, c_bytes);
+    ctx.add_flops(2ull * in.M * in.K * in.N);
