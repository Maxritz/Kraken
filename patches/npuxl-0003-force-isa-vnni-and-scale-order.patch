@@ -692,8 +692,17 @@ static void gemm_i8_vnni_tile(const GemmI8Params &p, const TileJob &tile,
                     __m512 dotsf = _mm512_cvtepi32_ps(acc[i][b]);
                     __m512 scalea = _mm512_set1_ps(
                         p.scale_a ? p.scale_a[m0 + i] : 1.0f);
+                    /* (dot * scale_a) * scale_b, in that order, because that
+                     * is what store_i8_c() does and float multiplication is
+                     * commutative but not associative. Multiplying the scales
+                     * the other way round is mathematically identical and
+                     * differs in the last bit, which is enough to make this
+                     * kernel the only arm that disagrees with the scalar
+                     * oracle -- caught by vnpu-isa-parity the first time VNNI
+                     * was actually reachable (it is not, if VNPU_FORCE_ISA
+                     * strips the VNNI bit; see runtime.cpp). */
                     __m512 out = _mm512_mul_ps(
-                        _mm512_mul_ps(dotsf, scalesb), scalea);
+                        _mm512_mul_ps(dotsf, scalea), scalesb);
                     std::memcpy(tmp, &out, sizeof(out));
                     for (uint32_t j = 0; j < counts[b]; ++j) {
                         float value = tmp[j];
