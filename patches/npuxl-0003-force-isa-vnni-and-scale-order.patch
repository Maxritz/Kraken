@@ -4,6 +4,8 @@
  */
 #include "../internal.h"
 
+#include <cstdio>
+
 #include <algorithm>
 #include <fstream>
 #include <iomanip>
@@ -728,11 +730,37 @@ VNPU_API vnpu_status_t VNPU_CALL vnpu_device_create(const vnpu_config_t *config,
         auto *device = new vnpu_device_t();
         device->config = cfg;
         device->cpu = vnpu::detect_cpu_features();
-        /* VNPU_FORCE_ISA=scalar|avx2|avx512 is useful for sanitizer builds and
+        /* VNPU_FORCE_ISA=scalar|avx2|avx512|avx512-novnni is useful for sanitizer builds and
          * deterministic cross-machine comparisons. */
         const char *forced_isa = std::getenv("VNPU_FORCE_ISA");
-        if (forced_isa && forced_isa[0]) {
-            std::string forced(forced_isa);
+        std::string forced = (forced_isa && forced_isa[0]) ? forced_isa : "";
+        if (!forced.empty()) {
+            /* Forcing an ISA the host cannot execute is a SIGILL, not a
+             * benchmark. Say so and keep what was detected. This matters on
+             * exactly the machines the flag is most tempting on: an AVX2-only
+             * host (Zen 3, pre-Skylake) asked for avx512 used to fault inside
+             * the first kernel instead of explaining itself. */
+            const bool have_avx2 =
+                (device->cpu.bits & VNPU_FEATURE_AVX2_FMA) != 0;
+            const bool have_avx512 =
+                (device->cpu.bits & VNPU_FEATURE_AVX512F) != 0;
+            const bool need_avx512 = forced.rfind("avx512", 0) == 0;
+            if ((need_avx512 && !have_avx512) ||
+                (forced == "avx2" && !have_avx2)) {
+                std::fprintf(stderr,
+                             "vnpu: VNPU_FORCE_ISA=%s requested but this CPU "
+                             "does not report %s; keeping the detected ISA "
+                             "(%s) instead of executing an illegal "
+                             "instruction\n",
+                             forced.c_str(),
+                             need_avx512 ? "AVX-512" : "AVX2+FMA",
+                             device->cpu.backend.empty()
+                                 ? "unknown"
+                                 : device->cpu.backend.c_str());
+                forced.clear();
+            }
+        }
+        if (!forced.empty()) {
             if (forced == "scalar") {
                 device->cpu.isa = vnpu::ISA_SCALAR;
                 device->cpu.simd_bits = 0;
@@ -747,12 +775,31 @@ VNPU_API vnpu_status_t VNPU_CALL vnpu_device_create(const vnpu_config_t *config,
                 device->cpu.bits &= ~(VNPU_FEATURE_AVX512F |
                                       VNPU_FEATURE_AVX512VNNI);
                 device->cpu.backend = "AVX2+FMA(forced)";
-            } else if (forced == "avx512") {
+            } else if (forced == "avx512" || forced == "avx512-novnni") {
+                /* Forcing the baseline ISA must not SUBTRACT a feature the host
+                 * actually has. This used to clear VNNI unconditionally, which
+                 * silently routed the int8 GEMM to the AVX2 kernel: measured
+                 * 31 GMAC/s instead of 130 on this box, 4.1x, with nothing in
+                 * the output saying so. Anyone comparing arms with
+                 * VNPU_FORCE_ISA=avx512 -- which is what the flag is for --
+                 * was measuring AVX2 and calling it AVX-512.
+                 *
+                 * avx512-novnni is the arm that genuinely wants the non-VNNI
+                 * kernel; it stays because that comparison is worth being able
+                 * to make, it just has to be asked for by name. */
+                const bool want_vnni = forced == "avx512";
                 device->cpu.isa = vnpu::ISA_AVX512;
                 device->cpu.simd_bits = 512;
                 device->cpu.bits |= VNPU_FEATURE_AVX512F;
-                device->cpu.bits &= ~VNPU_FEATURE_AVX512VNNI;
-                device->cpu.backend = "AVX512F(forced)";
+                if (want_vnni)
+                    device->cpu.backend = (device->cpu.bits &
+                                           VNPU_FEATURE_AVX512VNNI)
+                                              ? "AVX512F+VNNI(forced)"
+                                              : "AVX512F(forced)";
+                else {
+                    device->cpu.bits &= ~VNPU_FEATURE_AVX512VNNI;
+                    device->cpu.backend = "AVX512F(forced, no VNNI)";
+                }
             }
         }
         uint32_t threads = cfg.num_threads ? cfg.num_threads : device->cpu.logical_cpus;
